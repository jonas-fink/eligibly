{
  "name": "@eligibility/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @eligibility/shared && npm run build -w @eligibility/eligibility && tsx --watch --env-file=../../.env src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@eligibility/eligibility": "*",
    "@eligibility/shared": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "mongoose": "^8.18.0",
    "nodemailer": "^7.0.13",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
